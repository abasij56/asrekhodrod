{% macro post_image(post, width, height, loading) %}
  {% set img = ak_post_image_attrs(post, width, height) %}
  <img src="{{ img.src }}"{% if img.srcset %} srcset="{{ img.srcset }}" sizes="{{ img.sizes }}"{% endif %} width="{{ width }}" height="{{ height }}" alt="{{ post.title }}" loading="{{ loading|default('lazy') }}" decoding="async" />
{% endmacro %}

{% macro list_excerpt(post, context) %}
  {{ ak_list_excerpt(post, context|default('list')) }}
{% endmacro %}
